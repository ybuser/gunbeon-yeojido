# Copy to .env.local at the repository root. Never commit real keys.
# One general key works for the six services if each service is approved.
DATA_GO_KR_SERVICE_KEY=
# Optional browser key; restrict its allowed web domains in Kakao Developers.
KAKAO_MAP_JAVASCRIPT_KEY=
TEST_ACCESS_PASSWORD=
# Generate a random 32+ character signing secret; never expose it to the client.
TEST_SESSION_SECRET=
# Optional per-service overrides only when accounts/keys differ:
# TOUR_API_KOR_SERVICE_KEY=
# TOUR_API_WITH_SERVICE_KEY=
# TOUR_API_CONCENTRATION_KEY=
# TOUR_API_HUB_KEY=
# TOUR_API_RELATED_KEY=
# KMA_SERVICE_KEY=

# 개인 계정의 소셜 로그인 (서버 전용, 설정 전에는 연결 준비 중 표시)
# 운영 환경에서는 실제 HTTPS 사이트 origin으로 별도 등록
AUTH_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
